{
    "name": "davmixcool/laravel-meta-manager",
    "type": "library",
    "description": "Laravel Meta Manager is an SEO tool that is used to improve SEO of a website or specific page by adding recommended meta tags to your application. ",
    "keywords": ["seo","tags","meta-tags","metadata","open-graph","twitter-cards","social","laravel","davmixcool","laravel-meta-manager"],
    "homepage": "https://metamanager.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "David Oti",
            "email": "davmixcool@gmail.com",
            "role": "Senior Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Davmixcool\\MetaManager\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Davmixcool\\MetaManager\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Davmixcool\\MetaManager\\MetaServiceProvider"
            ],
            "aliases": {
                "Meta": "Davmixcool\\MetaManager\\Facades\\Meta"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:compat": "vendor/bin/phpunit --testsuite=compatibility"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
