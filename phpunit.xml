<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
>
    <testsuites>
        <!--
            The compatibility suite is the enforcement mechanism for the v1
            backwards-compatibility promise. It must never be skipped.
        -->
        <testsuite name="compatibility">
            <directory suffix="Test.php">./tests/Compatibility</directory>
        </testsuite>
        <testsuite name="fluent">
            <directory suffix="Test.php">./tests/Fluent</directory>
        </testsuite>
    </testsuites>
    <groups>
        <!-- DiffDumpTest writes head blocks for manual review; not assertions. -->
        <exclude>
            <group>dump</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory suffix=".php">./src</directory>
        </include>
    </source>
</phpunit>
